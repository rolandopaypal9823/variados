# Copiá este archivo a instagram/.env y completá los valores.
# instagram/.env está en .gitignore: el token NO se commitea nunca.
# Este repo es público — un token filtrado acá es un token robado.

# Token de acceso de larga duración (60 días). Ver README, paso 4.
IG_ACCESS_TOKEN=

# ID numérico de la cuenta de Instagram. "node instagram/publish.mjs doctor" te lo dice.
IG_USER_ID=

# Base pública desde donde Meta descarga los archivos de instagram/media/.
# Con el repo público, las URLs raw de GitHub alcanzan:
MEDIA_BASE_URL=https://raw.githubusercontent.com/rolandopaypal9823/variados/claude/hopeful-keller-b7vrra

# Host de la API. "doctor" detecta cuál te toca y te lo dice:
#   graph.instagram.com  → app con "inicio de sesión de Instagram" (lo del README)
#   graph.facebook.com   → app con inicio de sesión de Facebook
GRAPH_HOST=graph.instagram.com

# Opcionales
# GRAPH_API_VERSION=v26.0
# MAX_LATE_HOURS=6
# Sólo con GRAPH_HOST=graph.facebook.com, para renovar el token:
# META_APP_ID=
# META_APP_SECRET=
